{
  "name": "olive",
  "displayName": "OLIVE",
  "description": "A SLIME-style Common Lisp IDE",
  "version": "0.0.8",
  "publisher": "kchanqvq",
  "repository": "github:kchanqvq/olive",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "olive-repl-container",
          "title": "REPL",
          "icon": "$(repl)"
        }
      ]
    },
    "views": {
      "olive-repl-container": [
        {
          "type": "webview",
          "id": "olive.replView",
          "name": "REPL"
        }
      ]
    },
    "languages": [
      {
        "id": "common-lisp",
        "aliases": [
          "Common Lisp",
          "lisp"
        ],
        "extensions": [
          ".lisp",
          ".lsp",
          ".cl",
          ".l"
        ],
        "filenames": [
          "Source Form",
          "Macro Expansion"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "common-lisp",
        "scopeName": "source.lisp",
        "path": "./syntaxes/lisp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "olive.startLisp",
        "category": "OLIVE",
        "title": "Start Lisp and Connect"
      },
      {
        "command": "olive.connect",
        "category": "OLIVE",
        "title": "Connect to Swank Server"
      },
      {
        "command": "olive.disconnect",
        "category": "OLIVE",
        "title": "Disconnect from Swank Server"
      },
      {
        "command": "olive.interrupt",
        "category": "OLIVE",
        "title": "Interrupt"
      },
      {
        "command": "olive.evaluating",
        "category": "OLIVE",
        "title": "Evaluating... (Click to Interrupt)",
        "icon": "$(loading~spin)"
      },
      {
        "command": "olive.clearRepl",
        "category": "OLIVE",
        "title": "Clear REPL Output",
        "icon": "$(clear-all)"
      },
      {
        "command": "olive.syncRepl",
        "category": "OLIVE",
        "title": "Sync REPL package and default directory with editor",
        "icon": "$(sync)"
      },
      {
        "command": "olive.setReplPackage",
        "category": "OLIVE",
        "title": "Set REPL package",
        "icon": "$(symbol-module)"
      },
      {
        "command": "olive.replGoToDefinition",
        "category": "OLIVE",
        "title": "Go To Definition",
        "when": "olive.replView.active"
      },
      {
        "command": "olive.compileFile",
        "category": "OLIVE",
        "title": "Compile and load file",
        "icon": "$(run)"
      },
      {
        "command": "olive.compileFileDebug",
        "category": "OLIVE",
        "title": "Compile and load file (debug)",
        "icon": "$(debug-alt)"
      },
      {
        "command": "olive.loadFile",
        "category": "OLIVE",
        "title": "Load file",
        "icon": "$(file-text)"
      },
      {
        "command": "olive.compileDefun",
        "category": "OLIVE",
        "title": "Compile top level form"
      },
      {
        "command": "olive.compileDefunDebug",
        "category": "OLIVE",
        "title": "Compile top level form (debug)"
      },
      {
        "command": "olive.evalLastExpression",
        "category": "OLIVE",
        "title": "Evaluate last expression"
      },
      {
        "command": "olive.evalDefun",
        "category": "OLIVE",
        "title": "Evaluate top level form"
      },
      {
        "command": "olive.loadWorkspaceSystem",
        "category": "OLIVE",
        "title": "Load ASDF system for current workspace",
        "icon": "$(run)"
      },
      {
        "command": "olive.indentLine",
        "category": "OLIVE",
        "title": "Indent Line"
      },
      {
        "command": "olive.newlineAndIndent",
        "category": "OLIVE",
        "title": "Newline and Indent"
      },
      {
        "command": "olive.forwardSexp",
        "category": "OLIVE",
        "title": "Forward Expression",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardSexp",
        "category": "OLIVE",
        "title": "Backward Expression",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.downList",
        "category": "OLIVE",
        "title": "Move Into List",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardUpList",
        "category": "OLIVE",
        "title": "Move Backward Out of List",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.forwardUpList",
        "category": "OLIVE",
        "title": "Move Forward Out of List",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.forwardSlurp",
        "category": "OLIVE",
        "title": "Slurp Forward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardSlurp",
        "category": "OLIVE",
        "title": "Slurp Backward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.forwardBarf",
        "category": "OLIVE",
        "title": "Barf Forward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardBarf",
        "category": "OLIVE",
        "title": "Barf Backward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.spliceSexp",
        "category": "OLIVE",
        "title": "Splice Expression",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.splitSexp",
        "category": "OLIVE",
        "title": "Split Expression",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.wrapAround",
        "category": "OLIVE",
        "title": "Wrap Around Parentheses",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.forwardSpliceKill",
        "category": "OLIVE",
        "title": "Splice and Kill Forward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardSpliceKill",
        "category": "OLIVE",
        "title": "Splice and Kill Backward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.raiseSexp",
        "category": "OLIVE",
        "title": "Raise Expression",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.forwardKillSexp",
        "category": "OLIVE",
        "title": "Kill Expression Forward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.backwardKillSexp",
        "category": "OLIVE",
        "title": "Kill Expression Backward",
        "enablement": "config.olive.structuralEditing"
      },
      {
        "command": "olive.insertSemicolon",
        "category": "OLIVE",
        "title": "Insert Semicolon",
        "enablement": "config.olive.structuralEditing && config.olive.strictMode"
      },
      {
        "command": "olive.forwardDelete",
        "category": "OLIVE",
        "title": "Delete Forward",
        "enablement": "config.olive.structuralEditing && config.olive.strictMode"
      },
      {
        "command": "olive.backwardDelete",
        "category": "OLIVE",
        "title": "Delete Backward",
        "enablement": "config.olive.structuralEditing && config.olive.strictMode"
      },
      {
        "command": "olive.macrostep",
        "category": "OLIVE",
        "title": "Expand Macro"
      },
      {
        "command": "olive.macrostepCollapse",
        "category": "OLIVE",
        "title": "Collapse Expanded Macro",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      }
    ],
    "keybindings": [
      {
        "command": "olive.compileFile",
        "key": "f5",
        "when": "olive.activeLangId == common-lisp"
      },
      {
        "command": "olive.compileFileDebug",
        "key": "shift+f5",
        "when": "olive.activeLangId == common-lisp"
      },
      {
        "command": "olive.loadFile",
        "key": "alt+f5",
        "when": "olive.activeLangId == common-lisp"
      },
      {
        "command": "olive.compileDefun",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "olive.activeLangId == common-lisp"
      },
      {
        "command": "olive.compileDefunDebug",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "olive.activeLangId == common-lisp"
      },
      {
        "command": "olive.evalLastExpression",
        "key": "shift+enter",
        "when": "editorLangId == common-lisp"
      },
      {
        "command": "olive.evalDefun",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorLangId == common-lisp"
      },
      {
        "command": "olive.loadWorkspaceSystem",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "olive.startLisp",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "olive.indentLine",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && !editorTabMovesFocus && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible"
      },
      {
        "command": "olive.newlineAndIndent",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && !editorTabMovesFocus && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible"
      },
      {
        "command": "olive.forwardSexp",
        "key": "ctrl+right",
        "mac": "alt+right",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardSexp",
        "args": { "select": true },
        "key": "ctrl+shift+right",
        "mac": "shift+alt+right",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardSexp",
        "key": "ctrl+left",
        "mac": "alt+left",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardSexp",
        "args": { "select": true },
        "key": "ctrl+shift+left",
        "mac": "shift+alt+left",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.downList",
        "key": "ctrl+down",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.downList",
        "args": { "select": true },
        "key": "ctrl+shift+down",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardUpList",
        "key": "ctrl+up",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardUpList",
        "args": { "select": true },
        "key": "ctrl+shift+up",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardUpList",
        "key": "ctrl+alt+down",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardUpList",
        "args": { "select": true },
        "key": "ctrl+shift+alt+down",
        "when": "config.olive.structuralEditing && editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardSlurp",
        "key": "ctrl+alt+right",
        "linux": "ctrl+alt+.",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardSlurp",
        "key": "ctrl+alt+shift+left",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardBarf",
        "key": "ctrl+alt+left",
        "linux": "ctrl+alt+,",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardBarf",
        "key": "ctrl+alt+shift+right",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.spliceSexp",
        "key": "ctrl+alt+s",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.splitSexp",
        "key": "ctrl+shift+s",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.wrapAround",
        "key": "ctrl+alt+p",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardSpliceKill",
        "key": "ctrl+alt+shift+delete",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardSpliceKill",
        "key": "ctrl+alt+shift+backspace",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.raiseSexp",
        "key": "ctrl+alt+r",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardKillSexp",
        "key": "ctrl+delete",
        "mac": "alt+delete",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardKillSexp",
        "key": "ctrl+backspace",
        "mac": "alt+backspace",
        "when": "config.olive.structuralEditing && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.insertSemicolon",
        "key": ";",
        "when": "config.olive.structuralEditing && config.olive.strictMode && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.forwardDelete",
        "key": "delete",
        "when": "config.olive.structuralEditing && config.olive.strictMode && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.backwardDelete",
        "key": "backspace",
        "when": "config.olive.structuralEditing && config.olive.strictMode && editorTextFocus && !editorReadonly && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.replGoToDefinition",
        "key": "f12",
        "when": "olive.replView.active"
      },
      {
        "command": "olive.macrostep",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      },
      {
        "command": "olive.macrostep",
        "key": "=",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      },
      {
        "command": "olive.macrostep",
        "key": "e",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      },
      {
        "command": "olive.macrostep",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus && editorLangId == 'common-lisp'"
      },
      {
        "command": "olive.macrostepCollapse",
        "key": "delete",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      },
      {
        "command": "olive.macrostepCollapse",
        "key": "u",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      },
      {
        "command": "olive.macrostepCollapse",
        "key": "c",
        "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'"
      }
    ],
    "configuration": {
      "title": "OLIVE",
      "properties": {
        "olive.lispCommand": {
          "type": "string",
          "default": "sbcl",
          "description": "Command to start the Lisp subprocess."
        },
        "olive.autostart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Lisp when the extension activates."
        },
        "olive.completionStyle": {
          "type": "string",
          "default": "fuzzy",
          "enum": ["simple", "fuzzy"],
          "description": "Completion matching style",
          "enumDescriptions": ["Simple prefix matching", "Fuzzy matching"]
        },
        "olive.doubleClickInterval": {
          "type": "number",
          "default": 600,
          "description": "Delay in milliseconds to trigger double click action in the macro stepper. Set to a negative value to disable double click action."
        },
        "olive.evalFlashDuration": {
          "type": "number",
          "default": 200,
          "description": "Duration in milliseconds to flash the evaluated or compiled region. Set to 0 to disable flash."
        },
        "olive.structuralEditing": {
          "type": "boolean",
          "default": true,
          "description": "Bind keys for built-in structural editing."
        },
        "olive.strictMode": {
          "type": "boolean",
          "default": true,
          "description": "Avoid edits that unbalance parenthesis. This overrides some default VSCode commands."
        }
      }
    },
    "configurationDefaults": {
      "[common-lisp]": {
        "editor.autoClosingBrackets": "always",
        "editor.autoClosingQuotes": "always",
        "editor.autoClosingOvertype": "always"
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "olive.evalLastExpression",
          "when": "editorLangId == common-lisp",
          "group": "1_olive@1"
        },
        {
          "command": "olive.compileDefun",
          "when": "editorLangId == common-lisp",
          "group": "1_olive@2"
        },
        {
          "command": "olive.compileDefunDebug",
          "when": "editorLangId == common-lisp",
          "group": "1_olive@3"
        },
        {
          "command": "olive.evalDefun",
          "when": "editorLangId == common-lisp",
          "group": "1_olive@4"
        },
        {
          "command": "olive.syncRepl",
          "when": "editorLangId == common-lisp",
          "group": "1_olive@5"
        },
        {
          "command": "olive.macrostep",
          "when": "editorLangId == common-lisp",
          "group": "navigation@9"
        },
        {
          "command": "olive.macrostepCollapse",
          "when": "editorTextFocus && editorLangId == 'common-lisp' && resourceScheme == 'olive' && resourceFilename == 'Macro Expansion'",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "olive.evaluating",
          "when": "view == olive.replView && olive.isEvaluating",
          "group": "navigation@0"
        },
        {
          "command": "olive.syncRepl",
          "when": "view == olive.replView",
          "group": "navigation@1"
        },
        {
          "command": "olive.setReplPackage",
          "when": "view == olive.replView",
          "group": "navigation@2"
        },
        {
          "command": "olive.clearRepl",
          "when": "view == olive.replView",
          "group": "navigation@3"
        },
        {
          "command": "olive.loadWorkspaceSystem",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "olive.replGoToDefinition",
          "when": "webviewId == 'olive.replView'",
          "group": "navigation"
        },
        {
          "command": "olive.syncRepl",
          "when": "webviewId == 'olive.replView'",
          "group": "olive@1"
        },
        {
          "command": "olive.setReplPackage",
          "when": "webviewId == 'olive.replView'",
          "group": "olive@2"
        },
        {
          "command": "olive.clearRepl",
          "when": "webviewId == 'olive.replView'",
          "group": "olive@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "olive.compileFile",
          "when": "editorLangId == common-lisp",
          "group": "1_run"
        },
        {
          "command": "olive.compileFileDebug",
          "when": "editorLangId == common-lisp",
          "group": "1_run"
        },
        {
          "command": "olive.loadFile",
          "when": "editorLangId == common-lisp",
          "group": "1_run"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "npm run bundle-extension && npm run bundle-repl && npm run bundle-debug",
    "bundle-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:swank-client --external:paredit.js --format=cjs --platform=node",
    "bundle-repl": "esbuild ./resources/repl.js --bundle --outfile=out/repl.js --format=iife --platform=browser",
    "bundle-debug": "esbuild ./resources/debug.js --bundle --outfile=out/debug.js --format=iife --platform=browser --loader:.ttf=file",
    "fetch-slime": "curl -L https://github.com/slime/slime/archive/refs/tags/v2.32.tar.gz | tar xz && rm -rf slime && mv slime-2.32 slime",
    "bundle-watch": "npm run bundle -- --watch",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.31.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "paredit.js": "^0.4.0",
    "swank-client": "git+https://github.com/kchanqvq/swank-client.git"
  }
}
